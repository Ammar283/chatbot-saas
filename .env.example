# ---------------------------------------------------------------
# LLM provider. Any OpenAI-compatible endpoint works — swap freely.
# ---------------------------------------------------------------
# DeepSeek   https://api.deepseek.com/v1
# OpenRouter https://openrouter.ai/api/v1
# Groq       https://api.groq.com/openai/v1
# Together   https://api.together.xyz/v1
# OpenAI     https://api.openai.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-replace-me

# Cheap model handles ~90% of traffic.
LLM_MODEL=deepseek-chat

# Optional. Used only when the router decides a question is complex.
# Leave blank to run everything on the cheap model.
LLM_MODEL_SMART=

# ---------------------------------------------------------------
# Optional embeddings. Leave blank to run keyword-only retrieval,
# which costs nothing and is fine for a single website's content.
# ---------------------------------------------------------------
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=

# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
PORT=3000
DATA_DIR=./data

# Protects every /api/admin/* route. Generate a long random string.
ADMIN_KEY=change-this-to-something-long-and-random

# ---------------------------------------------------------------
# Cost ceilings. The bot stops answering when a tenant hits its cap,
# so one abusive visitor can never blow your margin.
# ---------------------------------------------------------------
DEFAULT_MONTHLY_MESSAGE_CAP=5000
MAX_MESSAGES_PER_VISITOR_PER_HOUR=30

# ---------------------------------------------------------------
# WhatsApp / Instagram via Meta Cloud API (optional, add later)
# ---------------------------------------------------------------
META_VERIFY_TOKEN=
META_PAGE_TOKEN=

# ---------------------------------------------------------------
# Cost display. Set both to 0 on a free tier so the dashboard tells
# the truth instead of estimating.
# ---------------------------------------------------------------
PRICE_IN_PER_M=0
PRICE_OUT_PER_M=0

# Optional second free tier. Used automatically when the primary is
# rate-limited or down.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# ---------------------------------------------------------------
# Owner account, created automatically on first run.
# ---------------------------------------------------------------
OWNER_EMAIL=you@yourcompany.com
OWNER_PASSWORD=pick-something-long

# Signs session cookies. Change it and everyone is signed out.
SESSION_SECRET=another-long-random-string

# ---------------------------------------------------------------
# Lead notifications. Per-client addresses are set in the dashboard;
# these are the credentials the server sends with.
# ---------------------------------------------------------------
# Email — resend.com, free tier, no card
RESEND_API_KEY=
NOTIFY_FROM=Front Desk <alerts@yourdomain.com>

# WhatsApp — Meta Cloud API
META_PAGE_TOKEN=
META_PHONE_ID=
# Needed for messages outside the 24-hour window, once Meta approves yours
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# ---------------------------------------------------------------
# Alerts to YOU when the bot stops working
# ---------------------------------------------------------------
OPERATOR_EMAIL=
OPERATOR_WHATSAPP=
OPERATOR_WEBHOOK=

# ---------------------------------------------------------------
# Backups. A nightly snapshot runs in-process. Set B2 or a presigned
# URL to get a copy off the server, which is the part that matters.
# ---------------------------------------------------------------
BACKUP_ENABLED=1
BACKUP_DIR=./backups
BACKUP_KEEP=14

# Backblaze B2 — 10GB free
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_ID=

# Or any presigned PUT URL (S3, Cloudflare R2, Google Cloud Storage)
BACKUP_PUT_URL=
